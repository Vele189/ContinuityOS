# Contact form email (api/contact.ts) — copy to .env locally, and add the same
# variables in your host's settings (e.g. Vercel → Project → Environment Variables).

# From https://resend.com/api-keys
RESEND_API_KEY=

# A sender on a domain you've verified in Resend
CONTACT_FROM="ContinuityOS <website@continuityos.co.za>"

# Optional — defaults to info@continuityos.co.za
# CONTACT_TO=info@continuityos.co.za
